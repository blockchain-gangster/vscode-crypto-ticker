{
  "name": "cc-prices",
  "displayName": "cc-prices",
  "version": "1.4.0",
  "publisher": "EzawaTami",
  "repository": {
    "type": "git",
    "url": "https://github.com/blockchain-gangster/vscode-crypto-ticker"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "configuration": {
      "properties": {
        "cc-prices.interval": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "description": "The refresh interval in seconds."
        },
        "cc-prices.onlyRefreshWhenFocused": {
          "type": "boolean",
          "default": false,
          "description": "Disable refreshing when the vscode window does not have focus."
        },
        "cc-prices.period": {
          "type": "string",
          "default": "24HOUR",
          "enum": [
            "HOUR",
            "24HOUR",
            "DAY"
          ],
          "enumDescriptions": [
            "The last hour",
            "The last 24 hours",
            "Since midnight UTC"
          ],
          "description": "The opening period."
        },
        "cc-prices.higherColor": {
          "type": "string",
          "default": "lightgreen",
          "description": "The color that indicates the symbol is trading higher."
        },
        "cc-prices.lowerColor": {
          "type": "string",
          "default": "coral",
          "description": "The color that indicates the symbol is trading lower."
        },
        "cc-prices.tickers": {
          "type": "array",
          "default": [
            {
              "symbol": "BTC",
              "currency": "USDT",
              "template": "{symbol} {price}"
            },
            {
              "symbol": "ETH"
            },
            {
              "symbol": "LTC"
            }
          ],
          "description": "The array of ticker definitions to display in the status bar."
        }
      }
    }
  },
  "scripts": {
    "check": "biome check",
    "check:fix": "biome check --write",
    "vscode:prepublish": "tsc -p ./ --noEmit && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --minify",
    "package": "vsce package --no-dependencies",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "@types/vscode": "^1.144.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
